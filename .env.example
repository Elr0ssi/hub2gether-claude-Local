# Copiez ce fichier en .env.local et remplissez les valeurs de votre projet
# Supabase (Project Settings > API). Les deux sont publiques.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Facultatif : le domaine des adresses fabriquées à partir des identifiants.
# Il ne reçoit aucun courriel et n'a pas à exister.
NEXT_PUBLIC_DOMAINE_COMPTES=
